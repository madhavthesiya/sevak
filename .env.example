# ── Local Development ──────────────────────────
DB_PASSWORD=your_postgres_password

# ── Production (Supabase + DigitalOcean) ───────
SEVAK_DB_URL=jdbc:postgresql://your-supabase-host:6543/postgres?prepareThreshold=0
SEVAK_DB_USER=postgres.your-project-ref
SEVAK_DB_PASSWORD=your_supabase_password

# ── Write-endpoint API key (required in production, no default there) ──
# Locally it defaults to "dev-admin-key". Use a long random value in production.
SEVAK_ADMIN_KEY=change-me-to-a-long-random-string
