# ── Local Development ──────────────────────────
DB_PASSWORD=your_postgres_password

# ── Production (Supabase + DigitalOcean) ───────
SEVAK_DB_URL=jdbc:postgresql://your-supabase-host:6543/postgres?prepareThreshold=0
SEVAK_DB_USER=postgres.your-project-ref
SEVAK_DB_PASSWORD=your_supabase_password

# ── Login tokens: at least 32 characters, required in production ──
SEVAK_JWT_SECRET=change-me-to-a-long-random-string-of-32-or-more-characters
# ── Comma-separated frontend URLs, required in production ──
SEVAK_CORS_ORIGINS=https://your-frontend.example.com
