# ── Local Development ──────────────────────────
# The owner (postgres), used by Flyway and the maintenance jobs
DB_PASSWORD=your_postgres_password
# sevak_app, the role the API's requests run as; Flyway sets this password on every start
SEVAK_APP_DB_PASSWORD=a_different_password_for_the_app_role

# ── Production (Supabase + DigitalOcean) ───────
# Requests: the sevak_app role (on Supabase's pooler the user name is sevak_app.<project-ref>)
SEVAK_DB_URL=jdbc:postgresql://your-supabase-host:6543/postgres?prepareThreshold=0
SEVAK_DB_USER=sevak_app.your-project-ref
SEVAK_APP_DB_PASSWORD=a_long_random_password_for_sevak_app
# The owner, for Flyway and the jobs: a session connection, superuser or BYPASSRLS
SEVAK_OWNER_DB_URL=jdbc:postgresql://your-supabase-host:5432/postgres
SEVAK_OWNER_DB_USER=postgres.your-project-ref
SEVAK_OWNER_DB_PASSWORD=your_supabase_password

# ── Login tokens: at least 32 characters, required in production ──
SEVAK_JWT_SECRET=change-me-to-a-long-random-string-of-32-or-more-characters
# ── Comma-separated frontend URLs, required in production ──
SEVAK_CORS_ORIGINS=https://your-frontend.example.com
